# Public project settings; never put service_role or database credentials in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: static frontend with a separate public news API (no credentials).
# VITE_GAME_UPDATES_API_URL=https://your-backend.example/api/game-updates
# Node server only: allow the exact frontend origin; same-origin needs neither.
# NEWS_ALLOWED_ORIGIN=https://your-site.example
# Optional existing Chromium executable on the Node host.
# NEWS_BROWSER_PATH=/usr/bin/chromium
